#!/bin/bash

# ═══════════════════════════════════════════════════════════════════════════════
# SYSTEM MAINTENANCE & OPTIMIZATION TOOL - FUTURISTIC EDITION
# ═══════════════════════════════════════════════════════════════════════════════

# --- Futuristic Color Scheme ---
BOLD=$'\033[1m'
DIM=$'\033[2m'
RESET=$'\033[0m'
UNDERLINE=$'\033[4m'

# Neon/Cyberpunk palette
NEON_BLUE=$'\033[38;5;39m'
NEON_CYAN=$'\033[38;5;51m'
NEON_PURPLE=$'\033[38;5;141m'
NEON_PINK=$'\033[38;5;200m'
NEON_GREEN=$'\033[38;5;46m'
NEON_YELLOW=$'\033[38;5;226m'
NEON_ORANGE=$'\033[38;5;208m'
NEON_RED=$'\033[38;5;196m'

# Gradient colors
GRAD_1=$'\033[38;5;33m'   # Deep blue
GRAD_2=$'\033[38;5;39m'   # Medium blue
GRAD_3=$'\033[38;5;45m'   # Cyan blue
GRAD_4=$'\033[38;5;51m'   # Bright cyan

# Text colors
TEXT_BRIGHT=$'\033[38;5;255m'
TEXT_NORMAL=$'\033[38;5;252m'
TEXT_DIM=$'\033[38;5;245m'
TEXT_SHADOW=$'\033[38;5;236m'

# Status colors
SUCCESS=$'\033[38;5;46m'
WARNING=$'\033[38;5;226m'
ERROR=$'\033[38;5;196m'
INFO=$'\033[38;5;51m'

# Status icons
ICON_SUCCESS="${SUCCESS}●${RESET}"
ICON_ERROR="${ERROR}●${RESET}"
ICON_WARNING="${WARNING}●${RESET}"
ICON_INFO="${INFO}●${RESET}"
ICON_ROCKET="${NEON_CYAN}❯${RESET}"
ICON_GEAR="${NEON_PURPLE}⚙${RESET}"
ICON_CHECK="${SUCCESS}✓${RESET}"
ICON_CROSS="${ERROR}✗${RESET}"
ICON_WRENCH="${NEON_ORANGE}🔧${RESET}"
ICON_CLEAN="${NEON_GREEN}◉${RESET}"
ICON_ARROW="${NEON_CYAN}▶${RESET}"

# --- Global Variables ---
CURRENT_TASK_MESSAGE=""
SCRIPT_COMPLETED_SUCCESSFULLY=false
SCRIPT_PROGRESS_PERCENT=0
SKIP_INTERACTIVE_ACTIONS=false
AUTOFIX_ENABLED=true

declare -A R_SYSTEM R_APT R_SNAP R_FLATPAK R_DRIVES R_HARDWARE R_OPTIMIZATIONS R_HEALTH R_FIXES R_CLEANUP
spinner_chars=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
spinner_index=0

# Fix tracking
FIXES_APPLIED=0
ISSUES_FOUND=0
BYTES_FREED=0
ISSUES_LIST=()

# Progress bar positioning
PROGRESS_LINE=0

# --- Utility Functions ---
print_header() {
    clear
    echo -e "${GRAD_1}╔═══════════════════════════════════════════════════════════════════════════╗${RESET}"
    echo -e "${GRAD_2}║${TEXT_BRIGHT}                                                                           ${GRAD_2}║${RESET}"
    echo -e "${GRAD_2}║${TEXT_BRIGHT}        ███████╗██╗   ██╗███████╗████████╗███████╗███╗   ███╗           ${GRAD_2}║${RESET}"
    echo -e "${GRAD_3}║${TEXT_BRIGHT}        ██╔════╝╚██╗ ██╔╝██╔════╝╚══██╔══╝██╔════╝████╗ ████║           ${GRAD_3}║${RESET}"
    echo -e "${GRAD_3}║${NEON_CYAN}        ███████╗ ╚████╔╝ ███████╗   ██║   █████╗  ██╔████╔██║           ${GRAD_3}║${RESET}"
    echo -e "${GRAD_4}║${NEON_CYAN}        ╚════██║  ╚██╔╝  ╚════██║   ██║   ██╔══╝  ██║╚██╔╝██║           ${GRAD_4}║${RESET}"
    echo -e "${GRAD_4}║${NEON_BLUE}        ███████║   ██║   ███████║   ██║   ███████╗██║ ╚═╝ ██║           ${GRAD_4}║${RESET}"
    echo -e "${GRAD_4}║${NEON_BLUE}        ╚══════╝   ╚═╝   ╚══════╝   ╚═╝   ╚══════╝╚═╝     ╚═╝           ${GRAD_4}║${RESET}"
    echo -e "${GRAD_3}║${TEXT_BRIGHT}                                                                           ${GRAD_3}║${RESET}"
    echo -e "${GRAD_2}║${NEON_PURPLE}          M A I N T E N A N C E   &   O P T I M I Z A T I O N             ${GRAD_2}║${RESET}"
    echo -e "${GRAD_1}║${TEXT_DIM}                         v2.0 Futuristic Edition                          ${GRAD_1}║${RESET}"
    echo -e "${GRAD_1}╚═══════════════════════════════════════════════════════════════════════════╝${RESET}"
    echo ""
}

log_action() {
    echo -e "  ${ICON_ROCKET} ${NEON_CYAN}${BOLD}$1${RESET}"
}

log_detail() {
    echo -e "    ${TEXT_DIM}├─ $1${RESET}"
}

log_success() {
    echo -e "    ${ICON_CHECK} ${SUCCESS}$1${RESET}"
}

log_warning() {
    echo -e "    ${ICON_WARNING} ${WARNING}$1${RESET}"
}

log_error() {
    echo -e "    ${ICON_CROSS} ${ERROR}$1${RESET}"
}

log_fix() {
    echo -e "    ${ICON_WRENCH} ${NEON_ORANGE}$1${RESET}"
    ((FIXES_APPLIED++))
}

log_issue() {
    local issue_description="$1"
    echo -e "    ${ICON_WARNING} ${WARNING}$issue_description${RESET}"
    ISSUES_LIST+=("$issue_description")
    ((ISSUES_FOUND++))
}

display_progress() {
    local percent=$1
    local task_message="$2"
    local bar_length=50

    local num_filled=$(( percent * bar_length / 100 ))
    if [ "$percent" -ge 100 ]; then num_filled=$bar_length; fi
    local num_empty=$(( bar_length - num_filled ))
    [[ $num_filled -lt 0 ]] && num_filled=0
    [[ $num_empty -lt 0 ]] && num_empty=0

    # Create gradient bar
    local filled_chars=""
    if [ "$num_filled" -gt 0 ]; then
        filled_chars=$(printf "%0.s█" $(seq 1 $num_filled 2>/dev/null || true))
    fi

    local empty_chars=""
    if [ "$num_empty" -gt 0 ]; then
        empty_chars=$(printf "%0.s░" $(seq 1 $num_empty 2>/dev/null || true))
    fi

    spinner_index=$(( (spinner_index + 1) % ${#spinner_chars[@]} ))
    local current_spinner="${spinner_chars[$spinner_index]}"

    # Progress bar starts right after the header (line 12)
    # Header is 11 lines tall
    if [ "$PROGRESS_LINE" -eq 0 ]; then
        PROGRESS_LINE=12
        # On first call, print empty lines to reserve space for logs below
        echo ""
        echo ""
        echo ""
        echo ""
    fi

    # Save current cursor position
    tput sc 2>/dev/null || true

    # Move to progress bar position (right under header)
    tput cup $PROGRESS_LINE 0 2>/dev/null || printf "\033[${PROGRESS_LINE};0H"

    # Clear the 4 lines for progress bar and redraw
    printf "\033[K"  # Clear line
    echo -e "${TEXT_DIM}┌────────────────────────────────────────────────────────────────────────┐${RESET}"
    printf "\033[K"  # Clear line
    printf "${TEXT_DIM}│${RESET} ${GRAD_2}${BOLD}Progress:${RESET} ${NEON_CYAN}%s${TEXT_SHADOW}%s${RESET} ${NEON_PURPLE}%3d%%${RESET} ${TEXT_DIM}│${RESET}\n" \
        "$filled_chars" "$empty_chars" "$percent"
    printf "\033[K"  # Clear line
    printf "${TEXT_DIM}│${RESET} ${current_spinner} ${TEXT_NORMAL}%-64s${TEXT_DIM} │${RESET}\n" "$task_message"
    printf "\033[K"  # Clear line
    echo -e "${TEXT_DIM}└────────────────────────────────────────────────────────────────────────┘${RESET}"

    # Restore cursor position (for logs to continue below)
    tput rc 2>/dev/null || true

    SCRIPT_PROGRESS_PERCENT=$percent
    CURRENT_TASK_MESSAGE="$task_message"
}

animate_progress_bar() {
    local target_percentage=$1
    local start_percentage=$SCRIPT_PROGRESS_PERCENT

    if [ "$target_percentage" -gt "$start_percentage" ] && [ "$SKIP_INTERACTIVE_ACTIONS" = false ]; then
        for ((p = start_percentage + 1; p < target_percentage; p++)); do
            display_progress "$p" "$CURRENT_TASK_MESSAGE"
            sleep 0.02
        done
    fi
}

print_divider() {
    echo -e "${TEXT_SHADOW}  ────────────────────────────────────────────────────────────────────${RESET}"
}

print_section_header() {
    local section_num="$1"
    local section_name="$2"
    echo ""
    echo -e "${NEON_PURPLE}  ╔═══════════════════════════════════════════════════════════════════╗${RESET}"
    echo -e "${NEON_PURPLE}  ║${RESET} ${NEON_CYAN}${BOLD}[${section_num}]${RESET} ${TEXT_BRIGHT}${BOLD}${section_name}${RESET}"
    echo -e "${NEON_PURPLE}  ╚═══════════════════════════════════════════════════════════════════╝${RESET}"
}

cleanup_on_exit() {
    tput cnorm 2>/dev/null || true
    if [ "$SCRIPT_COMPLETED_SUCCESSFULLY" = "false" ]; then
        echo ""
        echo -e "${ERROR}${BOLD}  ⚠ Script exited prematurely${RESET}"
        echo ""
    fi
}

interrupted_exit() {
    echo ""
    echo -e "${ERROR}${BOLD}  ⚠ Script interrupted by user${RESET}"
    echo ""
    exit 130
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

bytes_to_human() {
    local bytes=$1
    if [ "$bytes" -lt 1024 ]; then
        echo "${bytes}B"
    elif [ "$bytes" -lt 1048576 ]; then
        echo "$((bytes / 1024))KB"
    elif [ "$bytes" -lt 1073741824 ]; then
        echo "$((bytes / 1048576))MB"
    else
        echo "$((bytes / 1073741824))GB"
    fi
}

# --- Initialization ---
section_initial_setup() {
    log_action "Initializing system diagnostics..."
    R_SYSTEM["start_time"]=$(date +"%Y-%m-%d %H:%M:%S")
    export PAGER=cat
    export DEBIAN_FRONTEND=noninteractive

    if [ "$(id -u)" -ne 0 ]; then
        log_error "This script requires root privileges (sudo)"
        exit 1
    fi

    log_success "Root privileges confirmed"
    log_detail "Hostname: $(hostname)"
    log_detail "Kernel: $(uname -r)"
    log_detail "Uptime: $(uptime -p)"

    R_SYSTEM["privileges"]="${ICON_CHECK} Running with root privileges"
}

# --- APT Package Management ---
section_apt_maintenance() {
    log_action "APT Package Management System"

    # Fix broken packages first
    log_detail "Checking for broken packages..."
    if dpkg --audit 2>&1 | grep -q "broken"; then
        log_warning "Found broken packages - attempting repair"
        sudo dpkg --configure -a 2>&1 | tail -3 | sed 's/^/      /'
        sudo apt-get install -f -y 2>&1 | tail -3 | sed 's/^/      /'
        log_fix "Repaired broken package dependencies"
    fi

    # Remove stale lock files
    if [ -f /var/lib/dpkg/lock-frontend ] || [ -f /var/lib/apt/lists/lock ]; then
        log_detail "Checking for stale lock files..."
        if ! fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1; then
            sudo rm -f /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock /var/cache/apt/archives/lock 2>/dev/null
            log_fix "Removed stale package manager locks"
        fi
    fi

    R_APT["version_initial"]="$(apt --version | head -n 1 2>/dev/null || echo "N/A")"

    log_detail "Updating package repositories..."
    if sudo apt update -y 2>&1 | tee >(tail -5 | sed 's/^/      /' >&2) >/dev/null; then
        R_APT["update_status"]="${ICON_CHECK} Repository update successful"
        log_success "Repositories updated"

        log_detail "Upgrading system packages..."
        upgrade_output=$(sudo apt full-upgrade -y 2>&1)
        echo "$upgrade_output" | grep -E "upgraded|newly installed|to remove" | sed 's/^/      /' || true

        if echo "$upgrade_output" | grep -Eq "0 upgraded, 0 newly installed, 0 to remove"; then
            R_APT["full_upgrade_status"]="${ICON_INFO} All packages up-to-date"
            log_success "System already up-to-date"
        else
            R_APT["full_upgrade_status"]="${ICON_CHECK} System packages upgraded"
            log_success "Packages upgraded successfully"
        fi

        log_detail "Removing unnecessary packages..."
        autoremove_output=$(sudo apt autoremove -y 2>&1)
        removed_count=$(echo "$autoremove_output" | grep -oP '\d+(?= to remove)' | head -1)

        if [ -n "$removed_count" ] && [ "$removed_count" -gt 0 ]; then
            log_fix "Removed $removed_count unnecessary packages"
            R_APT["autoremove_status"]="${ICON_CHECK} Removed $removed_count packages"
        else
            R_APT["autoremove_status"]="${ICON_INFO} No packages to remove"
        fi

        log_detail "Cleaning package cache..."
        cache_size_before=$(du -sb /var/cache/apt/archives 2>/dev/null | awk '{print $1}')
        sudo apt clean &>/dev/null
        cache_size_after=$(du -sb /var/cache/apt/archives 2>/dev/null | awk '{print $1}')
        freed=$((cache_size_before - cache_size_after))
        BYTES_FREED=$((BYTES_FREED + freed))

        if [ "$freed" -gt 0 ]; then
            log_success "Cleared $(bytes_to_human $freed) from APT cache"
            R_APT["cache_clean"]="${ICON_CHECK} Cache cleaned"
        else
            R_APT["cache_clean"]="${ICON_INFO} Cache already clean"
        fi
    else
        R_APT["update_status"]="${ICON_ERROR} Repository update failed"
        log_error "Repository update failed"
    fi
}

# --- Snap Management ---
section_snap_maintenance() {
    if command_exists snap; then
        log_action "Snap Package Management"
        R_SNAP["installed"]="${ICON_CHECK} Snap installed"

        # Remove old snap revisions
        log_detail "Cleaning old snap revisions..."
        snap_list=$(snap list --all | awk '/disabled/{print $1, $3}')
        if [ -n "$snap_list" ]; then
            removed_count=0
            while read -r snapname revision; do
                sudo snap remove "$snapname" --revision="$revision" &>/dev/null
                ((removed_count++))
            done <<< "$snap_list"
            log_fix "Removed $removed_count old snap revisions"
        fi

        log_detail "Refreshing snap packages..."
        snap_output=$(sudo snap refresh 2>&1)

        if echo "$snap_output" | grep -qi "All snaps up to date"; then
            R_SNAP["updates"]="${ICON_INFO} All snaps up-to-date"
            log_success "Snap packages up-to-date"
        elif echo "$snap_output" | grep -E "refreshed|snap"; then
            R_SNAP["updates"]="${ICON_CHECK} Snap packages refreshed"
            log_success "Snap packages updated"
        fi
    else
        R_SNAP["installed"]="${ICON_INFO} Snap not installed"
    fi
}

# --- Flatpak Management ---
section_flatpak_maintenance() {
    if command_exists flatpak; then
        log_action "Flatpak Application Management"
        R_FLATPAK["installed"]="${ICON_CHECK} Flatpak installed"

        log_detail "Updating flatpak applications..."
        flatpak_output=$(flatpak update -y 2>&1)

        if echo "$flatpak_output" | grep -qi "Nothing to do"; then
            R_FLATPAK["updates"]="${ICON_INFO} All flatpaks up-to-date"
            log_success "Flatpak applications up-to-date"
        elif echo "$flatpak_output" | grep -Eqi "Updating|Changes:"; then
            R_FLATPAK["updates"]="${ICON_CHECK} Flatpak applications updated"
            log_success "Flatpak applications updated"
        fi

        log_detail "Removing unused flatpak runtimes..."
        unused_output=$(flatpak uninstall --unused -y 2>&1)
        if echo "$unused_output" | grep -q "Uninstalling"; then
            log_fix "Removed unused flatpak runtimes"
        fi
    else
        R_FLATPAK["installed"]="${ICON_INFO} Flatpak not installed"
    fi
}

# --- System Utilities ---
section_hardware_utility_installation() {
    log_action "Essential System Utilities"

    local tools_to_check=(
        "cpufrequtils:cpufreq-info"
        "lm-sensors:sensors"
        "smartmontools:smartctl"
        "e2fsprogs:e4defrag"
        "fwupd:fwupdmgr"
        "powertop:powertop"
        "preload:preload"
        "ncdu:ncdu"
        "btop:btop"
        "iotop:iotop"
        "htop:htop"
        "net-tools:ifconfig"
    )

    for entry in "${tools_to_check[@]}"; do
        local pkg="${entry%%:*}"
        local cmd="${entry##*:}"

        if ! command_exists "$cmd"; then
            log_detail "Installing $pkg..."
            if sudo apt install -y "$pkg" &>/dev/null; then
                log_success "$pkg installed"
            else
                log_warning "Failed to install $pkg"
            fi
        fi
    done
}

# --- System Cleanup & Optimization ---
section_deep_cleanup() {
    log_action "Deep System Cleanup"

    # Clean thumbnail cache
    log_detail "Cleaning thumbnail cache..."
    if [ -d "$HOME/.cache/thumbnails" ]; then
        size_before=$(du -sb "$HOME/.cache/thumbnails" 2>/dev/null | awk '{print $1}')
        rm -rf "$HOME/.cache/thumbnails"/* 2>/dev/null
        size_after=$(du -sb "$HOME/.cache/thumbnails" 2>/dev/null | awk '{print $1}')
        freed=$((size_before - size_after))
        BYTES_FREED=$((BYTES_FREED + freed))
        log_fix "Cleared $(bytes_to_human $freed) from thumbnail cache"
    fi

    # Clean old journal logs
    log_detail "Trimming old journal logs..."
    if command_exists journalctl; then
        size_before=$(journalctl --disk-usage 2>/dev/null | grep -oP '\d+\.\d+[MG]' | head -1)
        sudo journalctl --vacuum-time=7d &>/dev/null
        sudo journalctl --vacuum-size=500M &>/dev/null
        size_after=$(journalctl --disk-usage 2>/dev/null | grep -oP '\d+\.\d+[MG]' | head -1)
        log_fix "Journal logs trimmed (now: $size_after)"
    fi

    # Clean old logs
    log_detail "Cleaning old system logs..."
    old_logs=$(find /var/log -type f -name "*.gz" -o -name "*.old" -o -name "*.[0-9]" 2>/dev/null | wc -l)
    if [ "$old_logs" -gt 0 ]; then
        find /var/log -type f \( -name "*.gz" -o -name "*.old" -o -name "*.[0-9]" \) -delete 2>/dev/null
        log_fix "Removed $old_logs old log files"
    fi

    # Clean /tmp and /var/tmp
    log_detail "Cleaning temporary files..."
    tmp_size=$(du -sb /tmp /var/tmp 2>/dev/null | awk '{sum+=$1} END {print sum}')
    find /tmp -type f -atime +7 -delete 2>/dev/null
    find /var/tmp -type f -atime +7 -delete 2>/dev/null
    tmp_size_after=$(du -sb /tmp /var/tmp 2>/dev/null | awk '{sum+=$1} END {print sum}')
    freed=$((tmp_size - tmp_size_after))
    if [ "$freed" -gt 0 ]; then
        BYTES_FREED=$((BYTES_FREED + freed))
        log_fix "Cleared $(bytes_to_human $freed) from temp directories"
    fi

    # Clean old crash reports
    if [ -d /var/crash ]; then
        crash_count=$(find /var/crash -type f 2>/dev/null | wc -l)
        if [ "$crash_count" -gt 0 ]; then
            rm -rf /var/crash/* 2>/dev/null
            log_fix "Removed $crash_count crash reports"
        fi
    fi

    # Remove broken symlinks
    log_detail "Removing broken symlinks..."
    broken_links=$(find /usr /opt /home -xtype l 2>/dev/null | wc -l)
    if [ "$broken_links" -gt 0 ]; then
        find /usr /opt /home -xtype l -delete 2>/dev/null
        log_fix "Removed $broken_links broken symlinks"
    fi

    # Clean package manager caches
    log_detail "Purging orphaned configuration files..."
    orphaned=$(dpkg -l | grep '^rc' | awk '{print $2}')
    if [ -n "$orphaned" ]; then
        orphan_count=$(echo "$orphaned" | wc -l)
        echo "$orphaned" | xargs sudo apt-get purge -y &>/dev/null
        log_fix "Purged $orphan_count orphaned configs"
    fi

    R_CLEANUP["status"]="${ICON_CHECK} Deep cleanup completed"
}

# --- Drive Maintenance ---
section_drive_maintenance() {
    log_action "Drive Maintenance & Health"

    local lsblk_output=$(lsblk -P -o NAME,TYPE,MOUNTPOINT,FSTYPE,PKNAME,ROTA 2>&1)

    while IFS= read -r line; do
        NAME="" TYPE="" MOUNTPOINT="" FSTYPE="" PKNAME="" ROTA=""
        eval "$line"

        if [ "$TYPE" = "part" ] && [ -n "$MOUNTPOINT" ]; then
            local device="/dev/$NAME"

            if [ "$ROTA" = "0" ]; then
                # SSD - TRIM
                log_detail "Trimming SSD: $device ($MOUNTPOINT)..."
                if command_exists fstrim; then
                    trim_output=$(sudo fstrim -v "$MOUNTPOINT" 2>&1 | grep -oP '\d+(\.\d+)? [KMG]?B')
                    if [ -n "$trim_output" ]; then
                        log_success "Trimmed $trim_output on $device"
                    fi
                fi

                # Optimize SSD scheduler
                local sched_file="/sys/block/${PKNAME}/queue/scheduler"
                if [ -f "$sched_file" ]; then
                    if ! grep -q "\[none\]" "$sched_file" && ! grep -q "\[noop\]" "$sched_file"; then
                        echo "none" | sudo tee "$sched_file" &>/dev/null || echo "noop" | sudo tee "$sched_file" &>/dev/null
                        log_fix "Optimized I/O scheduler for SSD $PKNAME"
                    fi
                fi

            elif [ "$ROTA" = "1" ] && [ "$FSTYPE" = "ext4" ]; then
                # HDD - Check fragmentation
                if command_exists e4defrag; then
                    log_detail "Checking fragmentation: $device..."
                    frag_output=$(sudo e4defrag -c "$MOUNTPOINT" 2>&1)
                    frag_pct=$(echo "$frag_output" | grep -oP '\d+(?=% )' | tail -1)

                    if [ -n "$frag_pct" ] && [ "$frag_pct" -gt 15 ]; then
                        log_warning "High fragmentation ($frag_pct%) - defragmenting..."
                        sudo e4defrag "$MOUNTPOINT" &>/dev/null
                        log_fix "Defragmented $device"
                    fi
                fi

                # Optimize HDD scheduler
                local sched_file="/sys/block/${PKNAME}/queue/scheduler"
                if [ -f "$sched_file" ]; then
                    if ! grep -q "\[deadline\]" "$sched_file" && ! grep -q "\[mq-deadline\]" "$sched_file"; then
                        echo "mq-deadline" | sudo tee "$sched_file" &>/dev/null || echo "deadline" | sudo tee "$sched_file" &>/dev/null
                        log_fix "Optimized I/O scheduler for HDD $PKNAME"
                    fi
                fi
            fi
        fi
    done <<< "$lsblk_output"

    # Enable fstrim.timer for automatic SSD maintenance
    if systemctl list-unit-files | grep -q "fstrim.timer"; then
        if ! systemctl is-enabled fstrim.timer &>/dev/null; then
            sudo systemctl enable fstrim.timer &>/dev/null
            log_fix "Enabled automatic weekly SSD TRIM"
        fi
    fi
}

# --- Performance Optimizations ---
section_performance_optimization() {
    log_action "Performance Optimization"

    # Optimize swappiness
    log_detail "Checking swappiness..."
    current_swap=$(cat /proc/sys/vm/swappiness)
    if [ "$current_swap" -gt 10 ]; then
        sudo sysctl vm.swappiness=10 &>/dev/null
        echo "vm.swappiness=10" | sudo tee /etc/sysctl.d/99-swappiness.conf &>/dev/null
        log_fix "Optimized swappiness: $current_swap → 10"
    else
        log_success "Swappiness optimal ($current_swap)"
    fi

    # Optimize dirty page writeback
    if [ "$(cat /proc/sys/vm/dirty_ratio)" -gt 10 ]; then
        sudo sysctl vm.dirty_ratio=10 &>/dev/null
        sudo sysctl vm.dirty_background_ratio=5 &>/dev/null
        echo "vm.dirty_ratio=10" | sudo tee -a /etc/sysctl.d/99-performance.conf &>/dev/null
        echo "vm.dirty_background_ratio=5" | sudo tee -a /etc/sysctl.d/99-performance.conf &>/dev/null
        log_fix "Optimized dirty page writeback"
    fi

    # Clear caches
    log_detail "Clearing system caches..."
    sudo sync
    echo 3 | sudo tee /proc/sys/vm/drop_caches &>/dev/null
    log_success "System caches cleared"

    # Disable unnecessary services
    log_detail "Analyzing startup services..."
    local services_to_disable=()

    # Only suggest disabling if they exist and are enabled
    for service in bluetooth.service cups.service avahi-daemon.service; do
        if systemctl is-enabled "$service" &>/dev/null && ! systemctl is-active "$service" &>/dev/null; then
            services_to_disable+=("$service")
        fi
    done

    if [ ${#services_to_disable[@]} -gt 0 ]; then
        log_detail "Found ${#services_to_disable[@]} unused services that can be disabled"
    fi

    # Check for failed services and try to restart
    log_detail "Checking for failed services..."
    failed_services=$(systemctl list-units --state=failed --no-pager --no-legend | awk '{print $1}')
    if [ -n "$failed_services" ]; then
        while read -r service; do
            log_detail "Attempting to restart: $service"
            if sudo systemctl restart "$service" &>/dev/null; then
                log_fix "Restarted failed service: $service"
            fi
        done <<< "$failed_services"
    fi

    # Optimize preload
    if command_exists preload; then
        if ! systemctl is-active preload &>/dev/null; then
            sudo systemctl start preload &>/dev/null
            sudo systemctl enable preload &>/dev/null
            log_fix "Enabled preload for faster application startup"
        fi
    fi

    R_OPTIMIZATIONS["status"]="${ICON_CHECK} Performance optimized"
}

# --- Hardware & Firmware ---
section_hardware_checks() {
    log_action "Hardware Health & Firmware"

    # SMART disk health
    if command_exists smartctl; then
        log_detail "Checking disk health (SMART)..."
        for disk in $(lsblk -ndo NAME,TYPE | grep 'disk$' | awk '{print "/dev/"$1}'); do
            smart_output=$(sudo smartctl -H "$disk" 2>&1)
            if echo "$smart_output" | grep -qi "PASSED"; then
                log_success "$(basename $disk): SMART PASSED"
            elif echo "$smart_output" | grep -qi "FAILED"; then
                log_issue "Disk $(basename $disk) SMART test FAILED - Replace disk immediately!"
            fi
        done
    fi

    # Firmware updates
    if command_exists fwupdmgr; then
        log_detail "Checking firmware updates..."
        sudo fwupdmgr refresh --force &>/dev/null
        fw_updates=$(sudo fwupdmgr get-updates 2>&1)

        if ! echo "$fw_updates" | grep -qi "No upgrades"; then
            update_count=$(echo "$fw_updates" | grep -c "Update" || echo "0")
            if [ "$update_count" -gt 0 ]; then
                log_issue "Firmware updates available ($update_count device(s)) - Run: sudo fwupdmgr update"
            fi
        fi
    fi
}

# --- Network Optimization ---
section_network_optimization() {
    log_action "Network Configuration"

    # Fix DNS if needed
    if [ -f /etc/resolv.conf ]; then
        if ! grep -q "nameserver" /etc/resolv.conf || [ ! -s /etc/resolv.conf ]; then
            log_warning "DNS configuration issue detected"
            echo -e "nameserver 8.8.8.8\nnameserver 8.8.4.4" | sudo tee /etc/resolv.conf &>/dev/null
            log_fix "Fixed DNS configuration"
        fi
    fi

    # Check firewall status
    if command_exists ufw; then
        if ! sudo ufw status | grep -q "Status: active"; then
            log_issue "Firewall (UFW) is inactive - Enable for better security"
        else
            log_success "Firewall active"
        fi
    fi
}

# --- Generate Report ---
generate_final_report() {
    print_header

    echo -e "${NEON_CYAN}╔═══════════════════════════════════════════════════════════════════════════╗${RESET}"
    echo -e "${NEON_CYAN}║${TEXT_BRIGHT}                        MAINTENANCE REPORT SUMMARY                         ${NEON_CYAN}║${RESET}"
    echo -e "${NEON_CYAN}╚═══════════════════════════════════════════════════════════════════════════╝${RESET}"
    echo ""

    echo -e "  ${ICON_INFO} ${TEXT_BRIGHT}System:${RESET}     $(hostname)"
    echo -e "  ${ICON_INFO} ${TEXT_BRIGHT}Date:${RESET}       $(date '+%Y-%m-%d %H:%M:%S')"
    echo -e "  ${ICON_INFO} ${TEXT_BRIGHT}Kernel:${RESET}     $(uname -r)"
    echo -e "  ${ICON_INFO} ${TEXT_BRIGHT}Uptime:${RESET}     $(uptime -p)"
    print_divider

    echo ""
    echo -e "  ${NEON_GREEN}${BOLD}✓ ACTIONS COMPLETED${RESET}"
    echo -e "    ${ICON_CLEAN} Fixes Applied:      ${NEON_GREEN}${BOLD}$FIXES_APPLIED${RESET}"
    echo -e "    ${ICON_CLEAN} Space Freed:        ${NEON_GREEN}${BOLD}$(bytes_to_human $BYTES_FREED)${RESET}"
    echo -e "    ${ICON_WARNING} Issues Found:       ${WARNING}${BOLD}$ISSUES_FOUND${RESET}"
    echo ""

    if [ "$ISSUES_FOUND" -gt 0 ]; then
        echo -e "  ${WARNING}${BOLD}⚠ ATTENTION REQUIRED${RESET}"
        echo -e "    ${TEXT_DIM}The following issues require manual intervention:${RESET}"
        echo ""
        for issue in "${ISSUES_LIST[@]}"; do
            echo -e "    ${ICON_WARNING} ${WARNING}$issue${RESET}"
        done
        echo ""
    fi

    print_divider
    echo -e "  ${SUCCESS}${BOLD}✓ SYSTEM MAINTENANCE COMPLETE${RESET}"
    echo ""

    R_SYSTEM["end_time"]=$(date +"%Y-%m-%d %H:%M:%S")
}

# --- Interactive Fixes ---
apply_interactive_fixes() {
    if [ "$SKIP_INTERACTIVE_ACTIONS" = true ]; then
        echo -e "${INFO} Skipping interactive fixes (--skip mode)${RESET}"
        return
    fi

    echo ""
    echo -e "${NEON_PURPLE}╔═══════════════════════════════════════════════════════════════════════════╗${RESET}"
    echo -e "${NEON_PURPLE}║${TEXT_BRIGHT}                     OPTIONAL SYSTEM IMPROVEMENTS                          ${NEON_PURPLE}║${RESET}"
    echo -e "${NEON_PURPLE}╚═══════════════════════════════════════════════════════════════════════════╝${RESET}"
    echo ""

    # Flatpak installation
    if ! command_exists flatpak; then
        read -r -p "  Install Flatpak for additional applications? [y/N]: " choice
        if [[ "$choice" =~ ^[Yy]$ ]]; then
            sudo apt install -y flatpak &>/dev/null
            sudo flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo &>/dev/null
            echo -e "  ${ICON_CHECK} ${SUCCESS}Flatpak installed${RESET}"
        fi
    fi

    # Enable firewall if not active
    if command_exists ufw && ! sudo ufw status | grep -q "Status: active"; then
        read -r -p "  Enable firewall (UFW) for better security? [y/N]: " choice
        if [[ "$choice" =~ ^[Yy]$ ]]; then
            sudo ufw default deny incoming &>/dev/null
            sudo ufw default allow outgoing &>/dev/null
            sudo ufw limit ssh &>/dev/null
            yes | sudo ufw enable &>/dev/null
            echo -e "  ${ICON_CHECK} ${SUCCESS}Firewall enabled${RESET}"
        fi
    fi
}

# --- Main Execution ---
main() {
    # Parse arguments
    for arg in "$@"; do
        case "$arg" in
            --skip|-s)
                SKIP_INTERACTIVE_ACTIONS=true
                ;;
            --no-fix)
                AUTOFIX_ENABLED=false
                ;;
        esac
    done

    trap cleanup_on_exit EXIT
    trap interrupted_exit SIGINT SIGTERM
    tput civis 2>/dev/null || true

    print_header

    if [ "$SKIP_INTERACTIVE_ACTIONS" = true ]; then
        echo -e "${INFO} Running in non-interactive mode${RESET}"
        echo ""
    fi

    CURRENT_TASK_MESSAGE="Initializing system diagnostics"
    display_progress 0 "$CURRENT_TASK_MESSAGE"
    section_initial_setup

    animate_progress_bar 5
    CURRENT_TASK_MESSAGE="APT package maintenance & repairs"
    display_progress 5 "$CURRENT_TASK_MESSAGE"
    section_apt_maintenance

    animate_progress_bar 15
    CURRENT_TASK_MESSAGE="Snap package management"
    display_progress 15 "$CURRENT_TASK_MESSAGE"
    section_snap_maintenance

    animate_progress_bar 20
    CURRENT_TASK_MESSAGE="Flatpak application management"
    display_progress 20 "$CURRENT_TASK_MESSAGE"
    section_flatpak_maintenance

    animate_progress_bar 30
    CURRENT_TASK_MESSAGE="Installing essential utilities"
    display_progress 30 "$CURRENT_TASK_MESSAGE"
    section_hardware_utility_installation

    animate_progress_bar 40
    CURRENT_TASK_MESSAGE="Deep system cleanup & cache removal"
    display_progress 40 "$CURRENT_TASK_MESSAGE"
    section_deep_cleanup

    animate_progress_bar 55
    CURRENT_TASK_MESSAGE="Drive maintenance & optimization"
    display_progress 55 "$CURRENT_TASK_MESSAGE"
    section_drive_maintenance

    animate_progress_bar 70
    CURRENT_TASK_MESSAGE="Performance optimization"
    display_progress 70 "$CURRENT_TASK_MESSAGE"
    section_performance_optimization

    animate_progress_bar 85
    CURRENT_TASK_MESSAGE="Hardware health & firmware checks"
    display_progress 85 "$CURRENT_TASK_MESSAGE"
    section_hardware_checks

    animate_progress_bar 93
    CURRENT_TASK_MESSAGE="Network configuration"
    display_progress 93 "$CURRENT_TASK_MESSAGE"
    section_network_optimization

    animate_progress_bar 100
    CURRENT_TASK_MESSAGE="Generating report"
    display_progress 100 "$CURRENT_TASK_MESSAGE"
    sleep 0.5

    generate_final_report
    apply_interactive_fixes

    tput cnorm 2>/dev/null || true
    SCRIPT_COMPLETED_SUCCESSFULLY=true
    exit 0
}

main "$@"
